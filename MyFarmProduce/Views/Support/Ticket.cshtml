@model SupportTicket
@{ ViewData["Title"] = "Support chat"; }

<nav aria-label="breadcrumb">
    <ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Help</a></li><li class="breadcrumb-item active">Chat</li></ol>
</nav>

<div class="card">
    <div class="card-body">
        <partial name="_SupportMessages" model="Model" />
        <form asp-action="Send" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input name="message" class="form-control" placeholder="Reply..." autofocus required />
            <button type="submit" class="btn btn-success">Send</button>
        </form>
    </div>
</div>
