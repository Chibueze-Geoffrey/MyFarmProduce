@model List<SupportTicket>
@{ ViewData["Title"] = "Help & Support"; }

<h1 class="h3 mb-4">🤖 Help & Support</h1>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h6">Ask our assistant</h2>
        <p class="text-muted small">Order status, delivery, payment, refunds, product availability — ask away.</p>
        <form asp-action="Start" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input name="message" class="form-control" placeholder="Type your question..." required />
            <button type="submit" class="btn btn-success">Start chat</button>
        </form>
    </div>
</div>

<h2 class="h6">Your conversations</h2>
@if (!Model.Any())
{
    <p class="text-muted">No conversations yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var t in Model)
        {
            <a asp-action="Ticket" asp-route-id="@t.Id" class="list-group-item list-group-item-action d-flex justify-content-between">
                <span>@t.Subject</span>
                <span class="text-muted small">@t.CreatedAt.ToLocalTime().ToString("g")</span>
            </a>
        }
    </div>
}
