@model List<Order>
@{ ViewData["Title"] = "My Orders"; }

<h1 class="h3 mb-4">My Orders</h1>

@if (!Model.Any())
{
    <p class="text-muted">You haven't placed any orders yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Order</th><th>Date</th><th>Status</th><th class="text-end">Total</th><th></th></tr></thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td><span class="badge bg-secondary">@order.Status</span></td>
                        <td class="text-end">₦@order.Total.ToString("N2")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">Track</a>
                            <form asp-action="Reorder" asp-route-id="@order.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success">Reorder</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
