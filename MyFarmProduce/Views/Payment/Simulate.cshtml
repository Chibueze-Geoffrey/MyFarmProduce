@{
    ViewData["Title"] = "Payment";
    var reference = ViewData["Reference"] as string;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-center">
                <h1 class="h4 mb-3">💳 Simulated Payment Gateway</h1>
                <p class="text-muted">This is a stand-in for Paystack/Flutterwave (dev mode). Reference:</p>
                <code class="d-block mb-4">@reference</code>

                <form asp-action="Callback" method="post" class="d-grid gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reference" value="@reference" />
                    <button type="submit" name="success" value="true" class="btn btn-success btn-lg">Pay now (success)</button>
                    <button type="submit" name="success" value="false" class="btn btn-outline-danger">Cancel / fail payment</button>
                </form>
            </div>
        </div>
    </div>
</div>
