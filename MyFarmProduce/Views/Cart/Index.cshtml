@model CartViewModel
@{ ViewData["Title"] = "Your Cart"; }

<h1 class="h3 mb-4">Your Cart</h1>

@if (Model.IsEmpty)
{
    <p class="text-muted">Your cart is empty. <a asp-controller="Catalog" asp-action="Index">Start shopping</a>.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-end">Price</th>
                    <th style="width:180px">Qty</th>
                    <th class="text-end">Line total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr class="@(line.ExceedsStock ? "table-warning" : "")">
                        <td>
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@line.Product.Id" class="text-decoration-none">@line.Product.Name</a>
                            <small class="text-muted">/ @line.Product.Unit</small>
                            @if (line.ExceedsStock)
                            {
                                <div class="small text-danger">Only @line.Product.StockQty in stock</div>
                            }
                        </td>
                        <td class="text-end">₦@line.Product.Price.ToString("N2")</td>
                        <td>
                            <form asp-action="Update" method="post" class="d-flex gap-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@line.Product.Id" />
                                <input type="number" name="quantity" value="@line.Quantity" min="1" max="@line.Product.StockQty" class="form-control form-control-sm" style="width:80px" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                            </form>
                        </td>
                        <td class="text-end">₦@line.LineTotal.ToString("N2")</td>
                        <td class="text-end">
                            <form asp-action="Remove" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@line.Product.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row justify-content-end">
        <div class="col-md-4">
            <table class="table">
                <tr><td>Subtotal</td><td class="text-end">₦@Model.Subtotal.ToString("N2")</td></tr>
                <tr><td>Delivery fee</td><td class="text-end">₦@Model.DeliveryFee.ToString("N2")</td></tr>
                <tr class="fw-bold"><td>Total</td><td class="text-end">₦@Model.Total.ToString("N2")</td></tr>
            </table>
            @if (Model.HasStockIssues)
            {
                <div class="alert alert-warning">Adjust highlighted items before checkout.</div>
            }
            <a asp-controller="Checkout" asp-action="Index" class="btn btn-success w-100 @(Model.HasStockIssues ? "disabled" : "")">Proceed to checkout</a>
        </div>
    </div>
}
