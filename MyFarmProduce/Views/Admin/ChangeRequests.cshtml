@model List<ProfileChangeRequest>
@{ ViewData["Title"] = "Change Requests"; }

<h1 class="h3 mb-4">Profile Change Requests</h1>

@if (!Model.Any()) { <p class="text-muted">No change requests.</p> }

<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Customer</th><th>Field</th><th>Current</th><th>Requested</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Customer?.Name</td>
                    <td>@r.Field</td>
                    <td class="text-muted">@r.CurrentValue</td>
                    <td class="fw-bold">@r.RequestedValue</td>
                    <td><span class="badge bg-secondary">@r.Status</span></td>
                    <td class="text-end">
                        @if (r.Status == ChangeRequestStatus.Pending)
                        {
                            <form asp-action="ApproveChange" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                            <form asp-action="RejectChange" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">@r.ResolvedAt?.ToLocalTime().ToString("g")</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
