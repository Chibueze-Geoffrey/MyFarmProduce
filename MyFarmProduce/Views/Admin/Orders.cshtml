@model List<Order>
@{
    ViewData["Title"] = "Manage Orders";
    var status = ViewData["Status"] as OrderStatus?;
}

<h1 class="h3 mb-4">Orders</h1>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label">Status</label>
        <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<OrderStatus>()">
            <option value="">All</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="from" value="@ViewData["From"]" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="to" value="@ViewData["To"]" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-action="Orders" class="btn btn-link">Reset</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Order</th><th>Date</th><th>Customer</th><th>Status</th><th class="text-end">Total</th><th></th></tr></thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>@order.Customer?.Name</td>
                    <td><span class="badge bg-secondary">@order.Status</span></td>
                    <td class="text-end">₦@order.Total.ToString("N2")</td>
                    <td class="text-end"><a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">Manage</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <p class="text-muted">No orders match the filter.</p>
}
