@model Admin
@{ ViewData["Title"] = "Admin Profile"; }

<h1 class="h3 mb-4">My Profile</h1>

<div class="row">
    <div class="col-md-6">
        <div class="text-center mb-3">
            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
            {
                <img src="@Model.PhotoUrl" class="rounded-circle" style="width:96px;height:96px;object-fit:cover" alt="" />
            }
            else
            {
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary text-white" style="width:96px;height:96px;font-size:2rem">@(Model.Name.Length > 0 ? Model.Name[0] : 'A')</span>
            }
        </div>
        <form asp-action="Profile" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input name="name" value="@Model.Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Email (read-only)</label>
                <input value="@Model.Email" class="form-control" disabled />
            </div>
            <div class="mb-3">
                <label class="form-label">Profile photo</label>
                <input type="file" name="photoFile" accept="image/*" class="form-control" />
            </div>
            <button type="submit" class="btn btn-success">Save</button>
        </form>
    </div>
</div>
