@model SupportTicket
@{ ViewData["Title"] = $"Ticket #{Model.Id}"; }

<nav aria-label="breadcrumb">
    <ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Support">Tickets</a></li><li class="breadcrumb-item active">#@Model.Id</li></ol>
</nav>

<h1 class="h4">@Model.Subject</h1>
<p class="text-muted">@Model.Customer?.Name (@Model.Customer?.Email) · @Model.Status</p>

<partial name="_SupportMessages" model="Model" />
<p class="text-muted small">Read-only view of the assistant conversation.</p>
