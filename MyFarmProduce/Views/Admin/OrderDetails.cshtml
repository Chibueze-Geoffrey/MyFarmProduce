@model Order
@{ ViewData["Title"] = $"Order #{Model.Id}"; }

<h1 class="h3 mb-1">Order #@Model.Id</h1>
<p class="text-muted">@Model.CreatedAt.ToLocalTime().ToString("g") &middot; @Model.Customer?.Name (@Model.Customer?.Email)</p>

<div class="row">
    <div class="col-md-8">
        <table class="table">
            <thead><tr><th>Item</th><th class="text-center">Qty</th><th class="text-end">Price</th><th class="text-end">Total</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Product?.Name</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">₦@item.UnitPriceAtOrder.ToString("N2")</td>
                        <td class="text-end">₦@((item.UnitPriceAtOrder * item.Quantity).ToString("N2"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold"><td colspan="3" class="text-end">Total</td><td class="text-end">₦@Model.Total.ToString("N2")</td></tr>
            </tfoot>
        </table>

        <div class="card">
            <div class="card-body">
                <h2 class="h6">Delivery</h2>
                <p class="mb-1">@Model.DeliveryAddress</p>
                <p class="mb-1 text-muted">@Model.Phone</p>
                @if (!string.IsNullOrEmpty(Model.DeliveryNote))
                {
                    <p class="small text-muted mb-0">Note: @Model.DeliveryNote</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6">Status: <span class="badge bg-secondary">@Model.Status</span></h2>
                <form asp-action="UpdateStatus" method="post" class="d-flex gap-2 mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<OrderStatus>()"></select>
                    <button type="submit" class="btn btn-success">Set</button>
                </form>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6">Payment</h2>
                @if (Model.Payment is not null)
                {
                    <p class="mb-1">@Model.Payment.Provider — <span class="badge bg-secondary">@Model.Payment.Status</span></p>
                    <p class="small text-muted mb-0">Ref: @Model.Payment.Reference</p>
                    @if (Model.Payment.RefundedAt is not null)
                    {
                        <p class="small text-danger mb-0">Refunded @Model.Payment.RefundedAt?.ToLocalTime().ToString("g")</p>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No payment recorded.</p>
                }
            </div>
        </div>

        @if (Model.Status != OrderStatus.Cancelled)
        {
            <form asp-action="CancelOrder" method="post" class="mb-2" onsubmit="return confirm('Cancel this order?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger w-100">Cancel order</button>
            </form>
            <form asp-action="RefundOrder" method="post" onsubmit="return confirm('Mark as refunded?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="text" name="note" class="form-control mb-2" placeholder="Refund note (gateway ref, reason)" />
                <button type="submit" class="btn btn-outline-warning w-100">Refund (logged)</button>
            </form>
        }
    </div>
</div>
