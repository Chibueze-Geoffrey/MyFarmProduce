@model List<Product>
@{ ViewData["Title"] = "Manage Products"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Products</h1>
    <a asp-action="CreateProduct" class="btn btn-success">+ New product</a>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Name</th><th>Category</th><th>Unit</th><th class="text-end">Price</th><th class="text-center">Stock</th><th class="text-center">Available</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Category?.Name</td>
                    <td>@p.Unit</td>
                    <td class="text-end">₦@p.Price.ToString("N2")</td>
                    <td class="text-center">@p.StockQty</td>
                    <td class="text-center">@(p.IsAvailable ? "✅" : "—")</td>
                    <td class="text-end">
                        <a asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Restock" method="post" class="d-inline-flex gap-1 align-middle">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id" />
                            <input type="number" name="quantity" value="10" min="1" class="form-control form-control-sm" style="width:70px" />
                            <button type="submit" class="btn btn-sm btn-outline-success">Restock</button>
                        </form>
                        <form asp-action="DeleteProduct" method="post" class="d-inline" onsubmit="return confirm('Delete @p.Name?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
