@model List<ChatMessage>
@{ ViewData["Title"] = "Community Chat"; }

<h1 class="h3 mb-3">💬 Community Chat</h1>
<p class="text-muted small">Live chat with other MyFarmProduce shoppers. Be kind. 🌽</p>

<div id="chatBox" class="border rounded p-3 mb-3 bg-body-tertiary" style="height:420px;overflow-y:auto">
    @foreach (var m in Model)
    {
        <div class="mb-2">
            <span class="fw-bold">@m.SenderName</span>
            <span class="text-muted small">@m.CreatedAt.ToLocalTime().ToString("g")</span>
            <div>@m.Content</div>
        </div>
    }
</div>

<form id="chatForm" class="d-flex gap-2">
    <input id="chatInput" class="form-control" placeholder="Type a message..." autocomplete="off" maxlength="2000" required />
    <button type="submit" id="chatSend" class="btn btn-success" disabled>Send</button>
</form>
<div id="chatStatus" class="text-muted small mt-2">Connecting…</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script>
        const box = document.getElementById('chatBox');
        const form = document.getElementById('chatForm');
        const input = document.getElementById('chatInput');
        const sendBtn = document.getElementById('chatSend');
        const status = document.getElementById('chatStatus');
        box.scrollTop = box.scrollHeight;

        function escapeHtml(s) {
            return s.replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
        }

        if (!window.signalR) {
            status.textContent = 'Live chat unavailable (could not load SignalR). Reload to retry.';
        } else {
            const connection = new signalR.HubConnectionBuilder().withUrl('/hubs/chat').withAutomaticReconnect().build();

            connection.on('ReceiveMessage', (name, content, time) => {
                const div = document.createElement('div');
                div.className = 'mb-2';
                div.innerHTML = `<span class="fw-bold">${escapeHtml(name)}</span> <span class="text-muted small">${escapeHtml(time)}</span><div>${escapeHtml(content)}</div>`;
                box.appendChild(div);
                box.scrollTop = box.scrollHeight;
            });

            connection.start()
                .then(() => { status.textContent = 'Connected.'; sendBtn.disabled = false; })
                .catch(() => { status.textContent = 'Connection failed. Reload to retry.'; });

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const msg = input.value.trim();
                if (!msg) return;
                try { await connection.invoke('SendMessage', msg); input.value = ''; }
                catch { status.textContent = 'Message failed to send.'; }
            });
        }
    </script>
}
