@model CustomerProfileViewModel
@{ ViewData["Title"] = "My Profile"; var c = Model.Customer; }

<h1 class="h3 mb-4">My Profile</h1>

<div class="row g-4">
    <div class="col-md-6">
        <div class="text-center mb-3">
            @if (!string.IsNullOrEmpty(c.PhotoUrl))
            {
                <img src="@c.PhotoUrl" class="rounded-circle" style="width:96px;height:96px;object-fit:cover" alt="" />
            }
            else
            {
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary text-white" style="width:96px;height:96px;font-size:2rem">@(c.Name.Length > 0 ? c.Name[0] : '?')</span>
            }
        </div>
        <form asp-action="Index" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Display name</label>
                <input name="name" value="@c.Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Profile photo</label>
                <input type="file" name="photoFile" accept="image/*" class="form-control" />
            </div>
            <button type="submit" class="btn btn-success">Save profile</button>
        </form>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Contact details (locked 🔒)</h2>
                <p class="mb-1"><strong>Phone:</strong> @c.Phone</p>
                <p class="mb-3"><strong>Email:</strong> @c.Email</p>
                <p class="text-muted small">Phone and email can't be changed directly. Request a change and an admin will apply it.</p>

                <form asp-action="RequestChange" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <div class="col-4">
                        <select name="field" class="form-select">
                            <option value="Phone">Phone</option>
                            <option value="Email">Email</option>
                        </select>
                    </div>
                    <div class="col-5">
                        <input name="requestedValue" class="form-control" placeholder="New value" required />
                    </div>
                    <div class="col-3">
                        <button type="submit" class="btn btn-outline-secondary w-100">Request</button>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.ChangeRequests.Any())
        {
            <div class="mt-3">
                <h2 class="h6">My requests</h2>
                <ul class="list-group">
                    @foreach (var r in Model.ChangeRequests)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@r.Field → <strong>@r.RequestedValue</strong></span>
                            <span class="badge bg-secondary">@r.Status</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
