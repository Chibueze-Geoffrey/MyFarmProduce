@model List<Category>
@{
    ViewData["Title"] = "Shop";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Fresh Farm Produce</h1>
    <form method="get" class="d-flex" role="search">
        <input class="form-control me-2" type="search" name="q" value="@search" placeholder="Search produce..." />
        <button class="btn btn-outline-success" type="submit">Search</button>
    </form>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No products found@(string.IsNullOrEmpty(search) ? "." : $" for \"{search}\".")</p>
}

@foreach (var category in Model)
{
    <section class="mb-5">
        <h2 class="h4 border-bottom pb-2">@category.Name</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
            @foreach (var product in category.Products)
            {
                var soldOut = !product.IsAvailable || product.StockQty <= 0;
                <div class="col">
                    <div class="card h-100 @(soldOut ? "opacity-75" : "")">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height:160px;object-fit:cover" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height:160px">
                                <span class="display-6">🧺</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h3 class="h6">
                                <a class="text-decoration-none text-dark" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                            </h3>
                            <p class="mb-1 fw-bold">₦@product.Price.ToString("N2") <small class="text-muted fw-normal">/ @product.Unit</small></p>
                            @if (soldOut)
                            {
                                <span class="badge bg-secondary mb-2">Out of stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success mb-2">In stock (@product.StockQty)</span>
                            }
                            <div class="mt-auto">
                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <input type="number" name="quantity" value="1" min="1" max="@product.StockQty" class="form-control form-control-sm" style="width:70px" @(soldOut ? "disabled" : "") />
                                    <button type="submit" class="btn btn-sm btn-success flex-grow-1" @(soldOut ? "disabled" : "")>Add</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}
